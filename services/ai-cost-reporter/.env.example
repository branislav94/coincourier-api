# Public template only. Enter real values in protected runtime settings, never Git.
# The daily reporter does not automatically load .env.

# Actual provider-recorded API spend. Revoke/replace previously disclosed keys.
OPENAI_ADMIN_KEY=
# Optional comma-separated project IDs; blank requests organization-wide OpenAI costs.
OPENAI_PROJECT_IDS=
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=

# Apps Script delivery. Omitted GOOGLE_DRIVE_BACKEND defaults to legacy oauth in code.
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_BACKEND=apps_script
# Existing deployed HTTPS /exec URL, without query parameters. Never include a secret.
GOOGLE_APPS_SCRIPT_WEB_APP_URL=
# Exactly 64 lowercase hex characters; literal UTF-8 HMAC key, not hex-decoded.
# Store permanently only in protected Dokploy settings and AI_COST_SHARED_SECRET
# in Google Script Properties. A manual TEST run uses a temporary process variable.
GOOGLE_APPS_SCRIPT_SHARED_SECRET=

# Independent persistent reporter volume in Dokploy.
OUTPUT_DIR=/data/reports

# Optional legacy backend only: GOOGLE_DRIVE_BACKEND=oauth.
# Leave these blank for Apps Script; no Desktop OAuth client JSON is needed there.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_NAME=AI Infrastructure Costs

# Optional email: blank EMAIL_TO disables it. Require HOST/FROM if enabled.
EMAIL_TO=
SMTP_HOST=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_PORT=587
# USERNAME and PASSWORD must both be set or both be blank.
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional WhatsApp: blank WHATSAPP_TO disables it.
WHATSAPP_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=daily_ai_cost_report
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# TEST routing belongs ONLY in Google Script Properties, not this environment:
# AI_COST_TEST_UPLOADS_ENABLED must be true during a deliberate TEST check.
# AI_COST_TEST_PARENT_FOLDER_ID must identify a dedicated private test parent.
# The normal AI_COST_PARENT_FOLDER_ID remains optional and production-only.

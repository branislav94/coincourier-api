# Provider-recorded API costs. Use newly rotated values; NEVER paste credentials into Git.
OPENAI_ADMIN_KEY=
# Optional; blank means all OpenAI organization projects.
# Set to a comma-separated project ID list to report ONLY those projects.
OPENAI_PROJECT_IDS=
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=

# Google Drive upload. Fill three OAuth entries using scripts/authorize_google_drive.py.
GOOGLE_DRIVE_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_NAME=AI Infrastructure Costs

# Persistent volume directory in Dokploy.
OUTPUT_DIR=/data/reports

# LOCAL DEVELOPMENT / VECTOR VALIDATION ONLY.
# Interpolation values for maintenance/vector/docker-compose.vector.yml only.
# Never use this file as an API env_file or for persistent remote DEV/production.
# Remote databases are separately managed; their root secrets stay in those resources.
# Copy outside Git and replace placeholders for disposable local provisioning.
# Application VECTOR_DB_* values are a separate runtime contract; no root key belongs there.
VECTOR_MARIADB_DATABASE=coincourier_vectors
VECTOR_MARIADB_USER=replace-with-vector-app-user
VECTOR_MARIADB_PASSWORD=replace-with-vector-app-password
VECTOR_MARIADB_ROOT_PASSWORD=replace-with-vector-root-password

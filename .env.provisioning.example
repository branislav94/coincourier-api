# Compose interpolation and vector MariaDB provisioning only. Copy this file to
# a protected path outside the repository and replace every placeholder. Never
# pass it as the getnewsapi-web service env_file.

GETNEWSAPI_IMAGE=getnewsapi:phase7b
GETNEWSAPI_RUNTIME_ENV_FILE=.env.example
GETNEWSAPI_EDGE_NETWORK=getnewsapi-edge

# These application-user values must match VECTOR_DB_NAME, VECTOR_DB_USER, and
# VECTOR_DB_PASSWORD in the separate runtime environment file.
VECTOR_MARIADB_DATABASE=coincourier_vectors
VECTOR_MARIADB_USER=replace-with-vector-app-user
VECTOR_MARIADB_PASSWORD=replace-with-vector-app-password
VECTOR_MARIADB_ROOT_PASSWORD=replace-with-vector-root-password

# GetNewsAPI environment contract. Blank secret values must be supplied by the
# deployment secret store. Disabled optional features do not require credentials.

# HTTP / API SECURITY
# APP_ENV controls production startup validation and docs defaults.
APP_ENV=development
API_DOCS_ENABLED=true
# Required for the web profile; secret. POST /api/publish always requires it.
PUBLISH_API_TOKEN=
READINESS_DB_TIMEOUT_SECONDS=3

# CORE APPLICATION DB - required for every runtime profile.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_CONNECT_TIMEOUT_SECONDS=5
# Existing-compatible default: TLS offered, certificate verification off.
# Production may set verification true and mount a CA file at DB_SSL_CA.
DB_SSL_ENABLED=true
DB_SSL_VERIFY_CERT=false
DB_SSL_VERIFY_IDENTITY=false
DB_SSL_CA=

# WORDPRESS REST - required by publishing and scheduler profiles.
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# WORDPRESS DB - required by publishing and scheduler profiles.
WP_DB_USER=
WP_DB_PASSWORD=
WP_DB_HOST=
WP_DB_PORT=3306
WP_DB_NAME=
WP_DB_CONNECT_TIMEOUT_SECONDS=5
WP_DB_SSL_ENABLED=true
WP_DB_SSL_VERIFY_CERT=false
WP_DB_SSL_VERIFY_IDENTITY=false
WP_DB_SSL_CA=

# CRYPTONEWS - secret required by fetch/pipeline operation only.
CRYPTO_NEWS_TOKEN=

# xAI / GROK - secret required when Grok is selected by LLM/image routing.
PRIMARY_LLM_PROVIDER=grok
LLM_FALLBACK_PROVIDER=openai
GROK_API_KEY=
# XAI_API_KEY is a backward-compatible fallback alias for GROK_API_KEY.
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_TEXT_MODEL=grok-4.3
GROK_REASONING_EFFORT=
GROK_REASONING_EFFORT_DEFAULT=low
GROK_REASONING_EFFORT_REWRITE=low
GROK_REASONING_EFFORT_EXPANSION=low
GROK_REASONING_EFFORT_REPAIR=low
GROK_REASONING_EFFORT_SCORING=low
GROK_REASONING_EFFORT_CLASSIFY=low
GROK_REASONING_EFFORT_ANALYSIS=low
GROK_MAX_OUTPUT_TOKENS=4096

# OPENAI - secret required for OpenAI text/image routing or embeddings.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_OUTPUT_TOKENS=4096
SEO_PLUGIN=yoast

# GOOGLE - secret required by pipeline search enrichment.
GOOGLE_API_KEY=

# IMAGES - V1 remains the safe source default.
USE_API_IMAGES=1
IMAGE_SOURCE_MODE=hybrid
IMAGE_SOURCE_PRIORITY=stock_first
USE_SOURCE_IMAGES=false
PRIMARY_IMAGE_PROVIDER=grok
IMAGE_FALLBACK_PROVIDER=openai
GROK_IMAGE_MODEL=grok-imagine-image-quality
GROK_IMAGE_ASPECT_RATIO=16:9
GROK_IMAGE_RESOLUTION=1k
OPENAI_IMAGE_MODEL=gpt-image-1
# IMAGE_MODEL is retained as a backward-compatible alias.
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1024
OPENAI_IMAGE_FALLBACK=true
IMAGE_SEARCH_ENGINE=v1
IMAGE_SEARCH_PROVIDERS=pexels,pixabay,openverse
IMAGE_SEARCH_RESULTS_PER_QUERY=10
IMAGE_GLOBAL_CANDIDATE_LIMIT=50
IMAGE_MIN_WIDTH=1200
IMAGE_MIN_HEIGHT=675
IMAGE_PROVIDER_TIMEOUT_SECONDS=10
IMAGE_PROVIDER_MAX_RETRIES=1
IMAGE_LICENSE_ALLOWLIST=cc0,pdm,cc-by
IMAGE_GENERATION_ONLY_AFTER_SEARCH_EXHAUSTED=true
IMAGE_GENERATION_ON_PROVIDER_ERROR=false
PEXELS_ENABLED=true
PEXELS_API_KEY=
PEXELS_ORIENTATION=landscape
PEXELS_PER_PAGE=10
PEXELS_MIN_SCORE=0.72
PIXABAY_ENABLED=true
PIXABAY_API_KEY=
PIXABAY_ORIENTATION=horizontal
PIXABAY_PER_PAGE=10
PIXABAY_MIN_SCORE=0.78
OPENVERSE_ENABLED=true
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
OPENVERSE_MIN_SCORE=0.70
OPENVERSE_PER_PAGE=10
STOCK_IMAGE_TIMEOUT_SECONDS=10
STOCK_IMAGE_CACHE_HOURS=24
STOCK_IMAGE_REUSE_WINDOW_DAYS=20
STOCK_IMAGE_REUSE_CHECK_WP_HISTORY=true

# SCHEDULER - false for web containers; Phase 7C will define job orchestration.
ENABLE_APSCHEDULER=false
PIPELINE_FRESH_START_AFTER_UTC=

# DURABILITY - migrations must be applied manually before enabling.
PROCESS_DURABLE_CLAIMS_ENABLED=false
PROCESS_CLAIM_TIMEOUT_MINUTES=30
PUBLISH_DURABLE_STATE_ENABLED=false
PUBLISH_CLAIM_TIMEOUT_MINUTES=30

# DUPLICATE SHADOW - observational only; migration required before enabling.
DUPLICATE_SHADOW_ENABLED=false
DUPLICATE_LOOKBACK_HOURS=72
DUPLICATE_POLICY_VERSION=v1

# VECTOR DB - optional MariaDB 11.8 connection used only when VECTOR_ENABLED=true.
VECTOR_ENABLED=false
VECTOR_DB_HOST=
VECTOR_DB_PORT=3306
VECTOR_DB_NAME=coincourier_vectors
VECTOR_DB_USER=
VECTOR_DB_PASSWORD=
VECTOR_DB_CONNECT_TIMEOUT_SECONDS=5
# Compose-managed vector MariaDB is private and may use unencrypted container
# networking. External vector DB deployments can enable verification and mount a CA.
VECTOR_DB_SSL_ENABLED=true
VECTOR_DB_SSL_VERIFY_CERT=false
VECTOR_DB_SSL_VERIFY_IDENTITY=false
VECTOR_DB_SSL_CA=

# VECTOR DB PROVISIONING - required by docker-compose.prod.yml; no password defaults.
VECTOR_MARIADB_DATABASE=coincourier_vectors
VECTOR_MARIADB_USER=
VECTOR_MARIADB_PASSWORD=
VECTOR_MARIADB_ROOT_PASSWORD=

# EMBEDDING - disabled direct commands only; requires VECTOR_ENABLED and OpenAI key.
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_CHUNKER_VERSION=chunk-v1
EMBEDDING_BATCH_SIZE=16
EMBEDDING_INGEST_LIMIT=25
EMBEDDING_WORK_LIMIT=5
EMBEDDING_CLAIM_TIMEOUT_MINUTES=30
EMBEDDING_BACKFILL_PAGE_SIZE=100
EMBEDDING_MAX_CHUNKS_PER_JOB=100

# SEMANTIC - disabled evidence-only shadow; requires VECTOR_ENABLED when enabled.
SEMANTIC_SHADOW_ENABLED=false
SEMANTIC_LOOKBACK_HOURS=72
SEMANTIC_TOP_K=10
SEMANTIC_EVIDENCE_VERSION=semantic-shadow-v1

# THROUGHPUT - existing scheduling/cadence defaults.
DAILY_TARGET=75
ACTIVE_SHARE=0.8
ACTIVE_START_UTC=14:00
ACTIVE_END_UTC=02:00
SCHEDULE_MAX_AGE_HOURS=36
FETCH_POOL_SIZE=30
FETCH_SCORE_LIMIT=30
PROCESS_BATCH_MIN=3
PROCESS_BATCH_MAX=9
PROCESS_LOOKAHEAD_MINUTES=90
PUBLISH_BATCH_MAX=3

# LOGGING - stderr/stdout is canonical. File logging is opt-in only.
LOG_LEVEL=INFO
FILE_LOGGING_ENABLED=false
FILE_LOG_PATH=/data/logs/getnewsapi.log

# WRITABLE STATE - production Compose mounts a named volume at /data.
# Cache files are disposable; the usage JSON affects image reuse and is persistent.
# These development-compatible values are overridden to /data by production Compose.
WRITABLE_STATE_DIR=/app/cache
STOCK_IMAGE_CACHE_DIR=/app/cache/stock_images
STOCK_IMAGE_USAGE_PATH=/app/cache/stock_image_usage.json

# Provider smoke safety. Live smoke calls require explicit true values.
RUN_GROK_TEXT_SMOKE=false
RUN_GROK_IMAGE_SMOKE=false

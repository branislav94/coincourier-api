# Runtime controls
ENABLE_APSCHEDULER=false
FLASK_DEBUG=false
PIPELINE_FRESH_START_AFTER_UTC=

# Throughput controls
DAILY_TARGET=75
ACTIVE_SHARE=0.8
ACTIVE_START_UTC=14:00
ACTIVE_END_UTC=02:00
SCHEDULE_MAX_AGE_HOURS=36
FETCH_POOL_SIZE=30
FETCH_SCORE_LIMIT=30
PROCESS_BATCH_MIN=3
PROCESS_BATCH_MAX=9
PROCESS_LOOKAHEAD_MINUTES=90
PUBLISH_BATCH_MAX=3

# External APIs
CRYPTO_NEWS_TOKEN=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Image generation
USE_API_IMAGES=1
IMAGE_SOURCE_MODE=openai
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1024
OPENAI_IMAGE_FALLBACK=true

# Stock image providers
PEXELS_ENABLED=false
PEXELS_API_KEY=
PEXELS_ORIENTATION=landscape
PEXELS_PER_PAGE=10
PEXELS_MIN_SCORE=0.72
PIXABAY_ENABLED=false
PIXABAY_API_KEY=
PIXABAY_ORIENTATION=horizontal
PIXABAY_PER_PAGE=10
PIXABAY_MIN_SCORE=0.78
STOCK_IMAGE_TIMEOUT_SECONDS=10
STOCK_IMAGE_CACHE_HOURS=24

# Application database
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_NAME=

# WordPress REST API
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# WordPress database
WP_DB_USER=
WP_DB_PASSWORD=
WP_DB_HOST=
WP_DB_NAME=

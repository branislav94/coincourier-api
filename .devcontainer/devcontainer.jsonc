{
  "name": "GetNewsAPI-Dev",
  // Local source workspace only; never overlay a remote deployment contract.
  "dockerComposeFile": [ "docker-compose.yml" ],
  "service": "getnewsapi-local",
  "workspaceFolder": "/workspaces/api-test",
  // Start only the local editor workspace; no remote API or database resource.
  "runServices": [ "getnewsapi-local" ],
  "shutdownAction": "stopCompose",
  // expose API + debug port
  "forwardPorts": [ 5000, 5678 ],
  // The root Dockerfile already installs the pinned runtime dependencies.
  // recommend these Python extensions
  "extensions": [
    "ms-python.python",
    "ms-python.debugpy",
    "ms-python.vscode-pylance"
  ],
  "settings": {
    // Python inside container
    "python.defaultInterpreterPath": "/usr/local/bin/python"
  }
}
